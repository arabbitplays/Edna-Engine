#version 450

layout (binding = 0, rgba32f) uniform writeonly image2D target;
layout (binding = 1, rgba32f) uniform readonly image2D input_a;
layout (binding = 2, rgba32f) uniform readonly image2D input_b;
layout (binding = 3, rgba32f) uniform readonly image2D input_c;

layout (push_constant) uniform PushConstants {
    // Per-input weights; typically at most two are non-zero during a fade.
    float weight_a;
    float weight_b;
    float weight_c;
    uint  invert_color;
} pc;

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(target);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec4 a = imageLoad(input_a, pixel);
    vec4 b = imageLoad(input_b, pixel);
    vec4 c = imageLoad(input_c, pixel);

    vec4 blended = a * pc.weight_a + b * pc.weight_b + c * pc.weight_c;

    if (pc.invert_color != 0u) {
        blended.rgb = vec3(1.0) - blended.rgb;
    }

    imageStore(target, pixel, blended);
}
