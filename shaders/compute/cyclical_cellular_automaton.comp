#version 450

const uint MAX_STATE_COUNT = 64;

layout (binding = 0, r32ui)     uniform uimage2D stateImage;
layout (binding = 1, rgba32f)   uniform writeonly image2D targetImage;
layout (binding = 2)            uniform ColorPalette {
    vec4 colors[MAX_STATE_COUNT];
} palette;
layout (binding = 3, rgba32ui)  uniform uimage2D rngImage;

layout (push_constant) uniform PushConstants {
    uint  state_count;
    uint  threshold;
    uint  update;
    float update_chance;
    float mutation_chance;
} push;

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// PCG-based hash + 0..1 float generator (advances the in/out state each call).
uint hash(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float rand01(inout uint state) {
    state = hash(state);
    return float(state) * (1.0 / 4294967296.0);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(stateImage);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    uint current = imageLoad(stateImage, pixel).r;
    uint new_state = current;

    if (push.update != 0u) {
        uvec4 rng = imageLoad(rngImage, pixel);
        uint  rng_state = rng.x;

        if (rand01(rng_state) < push.update_chance) {
            uint next = (current + 1u) % push.state_count;
            uint matches = 0u;
            for (int dy = -1; dy <= 1; dy++) {
                for (int dx = -1; dx <= 1; dx++) {
                    if (dx == 0 && dy == 0) continue;
                    ivec2 npos = (pixel + ivec2(dx, dy) + size) % size;
                    if (imageLoad(stateImage, npos).r == next) matches++;
                }
            }

            if (matches >= push.threshold) {
                new_state = next;
                if (rand01(rng_state) < push.mutation_chance) {
                    new_state = uint(rand01(rng_state) * float(push.state_count)) % push.state_count;
                }
            }
        }

        rng.x = rng_state;
        imageStore(rngImage, pixel, rng);
        imageStore(stateImage, pixel, uvec4(new_state, 0, 0, 0));
    }

    imageStore(targetImage, pixel, palette.colors[new_state]);
}
